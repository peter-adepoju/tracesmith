# Supabase. Create a project at https://supabase.com, then copy these from
# Project Settings -> API. Both of these are safe to expose in the browser:
# row-level security in supabase/schema.sql is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the site is served from. Used to build the magic-link redirect.
# Locally this is http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
